{
    "name": "keepalived-status-monitor",
    "version": "0.0.0",
    "license": "MIT",
    "private": true,
    "packageManager": "npm@11.12.1",
    "workspaces": [
        "shared",
        "client",
        "server/backend",
        "server/frontend"
    ],
    "scripts": {
        "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
        "start:server": "npm run start -w server/backend",
        "start:client": "npm run start -w client",
        "dev:server": "npm run dev -w server/backend",
        "dev:frontend": "npm run dev -w server/frontend",
        "dev:client": "npm run dev -w client",
        "build": "npm run build -w shared && npm run build -w client -w server/backend -w server/frontend",
        "clean": "rimraf shared/dist client/dist server/backend/dist server/dist/public",
        "lint": "eslint .",
        "lint:frontend": "npm run lint -w server/frontend"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^11.0.1",
        "@semantic-release/npm": "^13.1.5",
        "eslint": "^10.10.0",
        "globals": "^17.3.0",
        "rimraf": "^6.1.3",
        "semantic-release": "^25.0.9",
        "typescript-eslint": "^8.70.0"
    },
    "release": {
        "branches": [
            "main"
        ],
        "plugins": [
            [
                "@semantic-release/commit-analyzer",
                {
                    "releaseRules": [
                        {
                            "breaking": true,
                            "release": "minor"
                        }
                    ]
                }
            ],
            [
                "@semantic-release/exec",
                {
                    "analyzeCommitsCmd": "test \"$FORCE_MAJOR\" = \"true\" && echo major || true",
                    "successCmd": "echo \"tag=v${nextRelease.version}\" >> $GITHUB_OUTPUT"
                }
            ],
            "@semantic-release/release-notes-generator",
            "@semantic-release/changelog",
            [
                "@semantic-release/npm",
                {
                    "npmPublish": false
                }
            ],
            [
                "@semantic-release/git",
                {
                    "assets": [
                        "package.json",
                        "package-lock.json",
                        "CHANGELOG.md"
                    ],
                    "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
                }
            ],
            "@semantic-release/github"
        ]
    }
}
